+func imageEditOutputModalities(model string, metadata map[string]any) []string {
+	formats, _ := metadata["supported_formats"].(map[string]any)
+	var textOutput bool
+	switch output := formats["output"].(type) {
+	case []string:
+		textOutput = slices.Contains(output, "text")
+	case []any:
+		textOutput = slices.Contains(output, any("text"))
+	default:
+		// Manually configured Gemini image models may lack catalog metadata.
+		textOutput = strings.HasPrefix(model, "google/gemini-")
+	}
+	if textOutput {
+		return []string{"image", "text"}
+	}
+	return []string{"image"}
 }
 
