+func TestOpenRouterImagesAdapterEditSendsMultimodalChat(t *testing.T) {
+	const inputURL = "https://example.com/source.png"
+	const inputDataURI = "data:image/png;base64,c291cmNl"
+	cases := []struct {
+		name           string
+		candidate      providerdto.ProviderCandidate
+		request        providerdto.ImageRequest
+		wantModel      string
+		wantModalities []string
+		wantImages     []string
+	}{
+		{
+			name:           "data URI with a prompt",
+			candidate:      providerdto.ProviderCandidate{Model: "google/gemini-2.5-flash-image"},
+			request:        providerdto.ImageRequest{Model: "ignored-model", ImageDataURI: " " + inputDataURI + " "},
+			wantModel:      "google/gemini-2.5-flash-image",
+			wantModalities: []string{"image", "text"},
+			wantImages:     []string{inputDataURI},
+		},
+		{
+			name:           "URL with a prompt",
+			request:        providerdto.ImageRequest{Model: " black-forest-labs/flux.2-pro ", ImageURL: inputURL, ImageDataURI: inputDataURI},
+			wantModel:      "black-forest-labs/flux.2-pro",
+			wantModalities: []string{"image"},
+			wantImages:     []string{inputURL},
+		},
+		{
+			name: "multiple images preserve their order and take precedence",
+			candidate: providerdto.ProviderCandidate{
+				Model: "test/image-model",
+				MetadataJSON: map[string]any{
+					"supported_formats": map[string]any{"output": []any{"text", "image"}},
+				},
+			},
+			request:        providerdto.ImageRequest{Images: []string{" ", inputDataURI, " " + inputURL + " "}, ImageURL: "https://example.com/ignored.png"},
+			wantModel:      "test/image-model",
+			wantModalities: []string{"image", "text"},
+			wantImages:     []string{inputDataURI, inputURL},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			type part struct {
+				Type     string `json:"type"`
+				Text     string `json:"text"`
+				ImageURL struct {
+					URL string `json:"url"`
+				} `json:"image_url"`
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodPost || r.URL.Path != "/api/v1/chat/completions" {
+					t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+				}
+				if r.Header.Get("Authorization") != "Bearer test-key" || r.Header.Get("Content-Type") != "application/json" {
+					t.Error("expected bearer authentication and JSON content type")
+				}
+				var received struct {
+					Model      string   `json:"model"`
+					Stream     bool     `json:"stream"`
+					Modalities []string `json:"modalities"`
+					Messages   []struct {
+						Role    string `json:"role"`
+						Content []part `json:"content"`
+					} `json:"messages"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&received); err != nil {
+					t.Errorf("decode request: %v", err)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				if received.Model != tc.wantModel || received.Stream || !slices.Equal(received.Modalities, tc.wantModalities) {
+					t.Errorf("model=%q stream=%v modalities=%v", received.Model, received.Stream, received.Modalities)
+				}
+				if len(received.Messages) != 1 || received.Messages[0].Role != "user" {
+					t.Errorf("messages=%+v", received.Messages)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				content := received.Messages[0].Content
+				if len(content) != len(tc.wantImages)+1 || content[0].Type != "text" || content[0].Text != "change the background to blue" {
+					t.Errorf("content=%+v", content)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				for i, want := range tc.wantImages {
+					if got := content[i+1]; got.Type != "image_url" || got.ImageURL.URL != want {
+						t.Errorf("image part %d=%+v, want %q", i, got, want)
+					}
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"created":1748372400,"choices":[{"message":{"role":"assistant","content":"Edited image","images":[{"type":"image_url","image_url":{"url":"data:image/png;base64,ZWRpdGVk"}},{"type":"image_url","image_url":{"url":"https://example.com/edited.png"}}]}}]}`))
+			}))
+			defer server.Close()
+
+			adapter := NewImagesAdapter(server.URL+"/api/v1", "test-key", logging.NewNop())
+			tc.request.Prompt = "  change the background to blue  "
+			tc.request.N = 1
+			resp, err := adapter.Edit(t.Context(), tc.candidate, tc.request)
+			if err != nil {
+				t.Fatalf("edit: %v", err)
+			}
+			wantData := []providerdto.ImageDataItem{{B64JSON: "ZWRpdGVk"}, {URL: "https://example.com/edited.png"}}
+			if resp.Created != 1748372400 || !slices.Equal(resp.Data, wantData) {
+				t.Errorf("response=%+v", resp)
+			}
+		})
+	}
+}
